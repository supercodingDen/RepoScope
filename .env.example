APP_ENV=development
PROVIDER_MODE=mock
ALLOW_PAID_API_CALLS=false
OPENAI_API_KEY=
# Required only for explicit PROVIDER_MODE=openai and ALLOW_PAID_API_CALLS=true.
# Verify the current official price yourself; this template never authorizes spending.
EMBEDDING_DAILY_BUDGET_USD=
EMBEDDING_PRICE_PER_MILLION_USD=
EMBEDDING_PRICE_VERIFIED_DATE=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_DEFAULT=gpt-5.6-luna
OPENAI_MODEL_ESCALATION=gpt-5.6-terra
OPENAI_MODEL_EXPERT=gpt-5.6-sol
ALLOW_MODEL_ESCALATION=false
ALLOW_EXPERT_MODEL=false
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384
MAX_INPUT_TOKENS_PER_CALL=24000
MAX_OUTPUT_TOKENS_PER_CALL=2000
MAX_AGENT_STEPS=6
MAX_MODEL_CALLS_PER_RUN=6
MAX_RUN_COST_USD=0.10
MAX_DAILY_COST_USD=1.00
MAX_PROJECT_COST_USD=4.00
INDEXER_CONCURRENCY=2
AGENT_CONCURRENCY=2
EMBEDDING_CONCURRENCY=2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_BATCH_MAX_TOKENS=20000
DATABASE_URL=
REDIS_URL=
NATS_URL=
REPOSCOPE_API_TOKEN=
REPOSCOPE_PRINCIPAL_ID=00000000-0000-0000-0000-000000000001

# Local Compose database credentials; use distinct random hex values.
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
API_PORT=8000

# Native indexer source acquisition; use absolute operator-owned paths.
# Compose supplies these values for its indexer service.
REPOSCOPE_SOURCE_ROOT=
REPOSCOPE_GIT_BINARY=

# Agent live mode also needs the existing embedding settings and explicit opt-in.
# Default Compose agent mode stays mock and makes no paid calls.
AGENT_INPUT_PRICE_PER_MILLION_USD=
AGENT_OUTPUT_PRICE_PER_MILLION_USD=
AGENT_PRICE_VERIFIED_DATE=

FROM pgvector/pgvector:0.8.7-pg17-bookworm@sha256:ac08538c6f8b9904c33c8224c5e5706dbe760aca29db1d096972b4052c22a75d

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libpcre2-8-0=10.42-1+deb12u2 \
        perl-base=5.36.0-7+deb12u4 \
        perl=5.36.0-7+deb12u4 \
        libperl5.36=5.36.0-7+deb12u4 \
        perl-modules-5.36=5.36.0-7+deb12u4 \
    && rm -rf /var/lib/apt/lists/* /usr/local/bin/gosu

USER postgres

{
  "$defs": {
    "IngestPayload": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        },
        "repository_id": {
          "format": "uuid",
          "title": "Repository Id",
          "type": "string"
        },
        "requested_ref": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Requested Ref",
          "type": "string"
        },
        "principal_id": {
          "format": "uuid",
          "title": "Principal Id",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "repository_id",
        "requested_ref",
        "principal_id"
      ],
      "title": "IngestPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "aggregate_id": {
      "format": "uuid",
      "title": "Aggregate Id",
      "type": "string"
    },
    "trace_id": {
      "format": "uuid",
      "title": "Trace Id",
      "type": "string"
    },
    "event_type": {
      "const": "repo.ingest.requested",
      "default": "repo.ingest.requested",
      "title": "Event Type",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/IngestPayload"
    }
  },
  "required": [
    "event_id",
    "occurred_at",
    "aggregate_id",
    "trace_id",
    "payload"
  ],
  "title": "IngestRequested",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

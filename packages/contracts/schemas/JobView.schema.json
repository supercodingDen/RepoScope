{
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "repository_id": {
      "format": "uuid",
      "title": "Repository Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "attempts": {
      "maximum": 5,
      "minimum": 0,
      "title": "Attempts",
      "type": "integer"
    },
    "progress_percent": {
      "maximum": 100,
      "minimum": 0,
      "title": "Progress Percent",
      "type": "integer"
    },
    "commit_sha": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Commit Sha"
    },
    "failure_code": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Failure Code"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "repository_id",
    "status",
    "attempts",
    "progress_percent",
    "commit_sha",
    "failure_code",
    "created_at",
    "updated_at"
  ],
  "title": "JobView",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "format": "uuid",
          "title": "Chunk Id",
          "type": "string"
        },
        "repository_id": {
          "format": "uuid",
          "title": "Repository Id",
          "type": "string"
        },
        "generation_id": {
          "format": "uuid",
          "title": "Generation Id",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        }
      },
      "required": [
        "chunk_id",
        "repository_id",
        "generation_id",
        "commit_sha",
        "path",
        "start_line",
        "end_line"
      ],
      "title": "Citation",
      "type": "object"
    },
    "CompletedData": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "run.completed",
          "default": "run.completed",
          "title": "Kind",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/RunResult"
        }
      },
      "required": [
        "result"
      ],
      "title": "CompletedData",
      "type": "object"
    },
    "FailedData": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "run.failed",
          "default": "run.failed",
          "title": "Kind",
          "type": "string"
        },
        "code": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "FailedData",
      "type": "object"
    },
    "RunResult": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "maxLength": 16000,
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 20,
          "title": "Citations",
          "type": "array"
        },
        "evidence_status": {
          "enum": [
            "supported",
            "insufficient"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "model": {
          "enum": [
            "mock",
            "gpt-5.6-luna",
            "gpt-5.6-terra",
            "gpt-5.6-sol"
          ],
          "title": "Model",
          "type": "string"
        },
        "estimated_cost_usd": {
          "pattern": "^\\d+\\.\\d{6}$",
          "title": "Estimated Cost Usd",
          "type": "string"
        }
      },
      "required": [
        "answer",
        "citations",
        "evidence_status",
        "model",
        "estimated_cost_usd"
      ],
      "title": "RunResult",
      "type": "object"
    },
    "StartedData": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "run.started",
          "default": "run.started",
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "enum": [
            "mock",
            "gpt-5.6-luna",
            "gpt-5.6-terra",
            "gpt-5.6-sol"
          ],
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "model"
      ],
      "title": "StartedData",
      "type": "object"
    },
    "ToolData": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "tool.started",
            "tool.completed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "tool": {
          "enum": [
            "search_code",
            "get_file",
            "get_repository_summary"
          ],
          "title": "Tool",
          "type": "string"
        },
        "step": {
          "maximum": 6,
          "minimum": 1,
          "title": "Step",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "tool",
        "step"
      ],
      "title": "ToolData",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "data": {
      "discriminator": {
        "mapping": {
          "run.completed": "#/$defs/CompletedData",
          "run.failed": "#/$defs/FailedData",
          "run.started": "#/$defs/StartedData",
          "tool.completed": "#/$defs/ToolData",
          "tool.started": "#/$defs/ToolData"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/StartedData"
        },
        {
          "$ref": "#/$defs/ToolData"
        },
        {
          "$ref": "#/$defs/CompletedData"
        },
        {
          "$ref": "#/$defs/FailedData"
        }
      ],
      "title": "Data"
    }
  },
  "required": [
    "run_id",
    "sequence",
    "occurred_at",
    "data"
  ],
  "title": "RunEvent",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

{
  "$defs": {
    "SearchMatch": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "format": "uuid",
          "title": "Chunk Id",
          "type": "string"
        },
        "repository_id": {
          "format": "uuid",
          "title": "Repository Id",
          "type": "string"
        },
        "generation_id": {
          "format": "uuid",
          "title": "Generation Id",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "score": {
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "content": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "repository_id",
        "generation_id",
        "commit_sha",
        "path",
        "start_line",
        "end_line",
        "score",
        "content"
      ],
      "title": "SearchMatch",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "repository_id": {
      "format": "uuid",
      "title": "Repository Id",
      "type": "string"
    },
    "generation_id": {
      "format": "uuid",
      "title": "Generation Id",
      "type": "string"
    },
    "commit_sha": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Commit Sha",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/SearchMatch"
      },
      "maxItems": 20,
      "title": "Results",
      "type": "array"
    },
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "number"
    }
  },
  "required": [
    "repository_id",
    "generation_id",
    "commit_sha",
    "results",
    "duration_ms"
  ],
  "title": "SearchResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

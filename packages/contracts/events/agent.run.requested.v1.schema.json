{
  "$defs": {
    "AgentPayload": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "repository_id": {
          "format": "uuid",
          "title": "Repository Id",
          "type": "string"
        },
        "generation_id": {
          "format": "uuid",
          "title": "Generation Id",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "principal_id": {
          "format": "uuid",
          "title": "Principal Id",
          "type": "string"
        },
        "policy_version": {
          "const": "routing-v1",
          "default": "routing-v1",
          "title": "Policy Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "repository_id",
        "generation_id",
        "commit_sha",
        "principal_id"
      ],
      "title": "AgentPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "aggregate_id": {
      "format": "uuid",
      "title": "Aggregate Id",
      "type": "string"
    },
    "trace_id": {
      "format": "uuid",
      "title": "Trace Id",
      "type": "string"
    },
    "event_type": {
      "const": "agent.run.requested",
      "default": "agent.run.requested",
      "title": "Event Type",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/AgentPayload"
    }
  },
  "required": [
    "event_id",
    "occurred_at",
    "aggregate_id",
    "trace_id",
    "payload"
  ],
  "title": "AgentRequested",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

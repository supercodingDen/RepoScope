FROM golang:1.27.3-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS nats-build

ENV GOTOOLCHAIN=local CGO_ENABLED=0
RUN go install github.com/nats-io/nats-server/v2@v2.15.1 \
    && /go/bin/nats-server --version

FROM nats:2.15.1-alpine@sha256:7ae34c25dfd6fe2e01c6483eabef20d796690fdcac6c4d94ca780a6cf9877fde

COPY --from=nats-build /go/bin/nats-server /usr/local/bin/nats-server

COPY LICENSE /licenses/Apache-2.0.txt
COPY docs/nats-notice.txt /licenses/NATS-NOTICE.txt

RUN mkdir -p /data && chown 10001:10001 /data

USER 10001:10001
